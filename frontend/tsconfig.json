{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "jsx": "preserve",
    "types": ["vite/client"],
    "skipLibCheck": true,
    "noEmit": true,
    "paths": {
      "@dnftools/ui": ["./src/vendor/@dnftools/ui/index.d.ts"],
      "@dnftools/ui/style.css": ["./src/vendor/@dnftools/ui/style.css"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.vue", "vite.config.ts"]
}
