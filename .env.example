DNFER_SECRET_KEY=please-change-me
DNFER_ADMIN_PASSWORD=please-change-me
DNFER_API_TOKEN=please-change-me-bot-token
DNFER_ADMIN_USERNAME=admin
DNFER_ADMIN_NICKNAME=群主

# S3 头像存储（公开读桶；留空则头像上传不可用，返回 503）
DNFER_S3_ENDPOINT=
DNFER_S3_ACCESS_KEY=
DNFER_S3_SECRET_KEY=
DNFER_S3_BUCKET=
DNFER_S3_REGION=
DNFER_S3_PUBLIC_BASE=

# 社区同步（独立 web 服务，DNfer 后端 worker 内网调用；Docker 部署下 compose 会覆盖为 http://community-sync:8100）
DNFER_COMMUNITY_SYNC_BASE=http://127.0.0.1:8100
DNFER_COMMUNITY_SYNC_MAX_RETRY=3

# 社区查询服务的 dnfbbz 登录凭据（Docker 部署经 compose 传入；留空用默认 1010268482/123456）
DNFBBZ_USER=1010268482
DNFBBZ_PASS=123456
